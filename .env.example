# ==============================================================
# AI VIRAL SHORTS AUTOMATION - ENVIRONMENT CONFIGURATION
# ==============================================================

# Optional: Gemini API Key for unlimited dynamic script writing
# (If left empty, system uses high-converting built-in viral psychology library)
GEMINI_API_KEY=

# Voice Settings (Microsoft Edge Neural Voice)
# Default is 'en-US-ChristopherNeural' (Deep, dramatic baritone ideal for Dark Psychology)
VOICE_NAME=en-US-ChristopherNeural
VOICE_RATE=+0%
VOICE_PITCH=-2Hz

# ==============================================================
# YOUTUBE AUTOMATION (YouTube Data API v3)
# ==============================================================
# Download client_secret.json from Google Cloud Console (OAuth Client ID - Desktop App)
# and put it inside this folder as 'client_secret.json'
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_PRIVACY_STATUS=public

# ==============================================================
# META (INSTAGRAM & FACEBOOK) GRAPH API
# ==============================================================
# Instagram Creator/Business Account ID (Get from Meta Graph API Explorer)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Facebook Page ID and Page Access Token
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
